{
  "name": "community-manager-toolkit-connector",
  "version": "0.1.0",
  "description": "Community Manager Toolkit by CommonOS: hosted MCP connector (Phase 1, stateless, nothing stored).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/sync-site.mjs && tsx src/server.ts",
    "build": "node scripts/sync-site.mjs && tsc -p tsconfig.json && tsc -p tsconfig.ui.json && node dist/build-ui.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "fonts:stage": "node scripts/stage-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
